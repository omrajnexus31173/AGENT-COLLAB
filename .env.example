# Copy to .env.local. Never commit real values. npm run setup generates local secrets.
DATABASE_URL=postgresql://nexus:YOUR_LOCAL_PASSWORD@127.0.0.1:54329/nexus
# Used only by compose.yaml; match the password in DATABASE_URL when using Compose.
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# TLS CA for managed PostgreSQL when required (PEM; escaped newlines supported).
DATABASE_SSL=false
DATABASE_CA_CERT=
# Exactly 32 random bytes, base64 encoded. Rotating this makes stored credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=
# Required in production; must be the canonical HTTPS origin, no trailing slash.
APP_ORIGIN=http://localhost:3000
# Development only. Allows loopback Ollama/LM Studio. Never enable on a shared server.
ALLOW_LOCAL_PROVIDERS=false
# Optional operator-approved HTTPS origins for self-hosted compatible providers.
# Exact origins only, comma-separated. DNS must resolve exclusively to public addresses.
PROVIDER_ORIGIN_ALLOWLIST=
# Optional live integration tests. These make real, billable requests.
# Keep false unless you intentionally want to run them against a *_test database.
NEXUS_RUN_LIVE_TESTS=false
# Use two different real providers/models.
NEXUS_LIVE_PROVIDER_A=openai
NEXUS_LIVE_KEY_A=
NEXUS_LIVE_MODEL_A=
NEXUS_LIVE_PROVIDER_B=anthropic
NEXUS_LIVE_KEY_B=
NEXUS_LIVE_MODEL_B=
# Optional custom endpoints for live tests (same SSRF rules as the application).
NEXUS_LIVE_BASE_A=
NEXUS_LIVE_BASE_B=
# Optional operator CI database; tests refuse non-test database names.
TEST_DATABASE_URL=
# Set true on an ephemeral/web-only tier when running `npm run worker` separately.
NEXUS_DISABLE_WORKER=false
# Optional dedicated database for the standalone production-browser workflow test.
# Defaults to nexus_browser_test on the local DATABASE_URL host. Destructive: *_test only.
WORKFLOW_DATABASE_URL=
